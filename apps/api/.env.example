# ============ DeepSeek（只给 web_search 的 tool search 用）============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ 对话模型（任意 OpenAI 兼容端点；三项留空则回退 DEEPSEEK_*）============
# 商汤 SenseNova 示例：
#   LLM_BASE_URL=https://token.sensenova.cn/v1
#   LLM_MODEL=SenseChat-5        # 便宜档：SenseChat-Turbo
# Qwen/SiliconFlow 示例：
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 本地 Ollama 示例：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ============ Web 搜索（最后填写 key，为空走模拟数据）============
TAVILY_API_KEY=

# ============ 单源故障注入（仅评测/演练，默认关闭）============
# 例：FAULT_INJECT_SOURCE=arxiv,web  FAULT_INJECT_MODE=timeout  FAULT_INJECT_RATE=1.0
FAULT_INJECT_SOURCE=
FAULT_INJECT_MODE=timeout
FAULT_INJECT_RATE=1.0

# ============ 向量/精排模型（本地目录，绝不落 C 盘）============
HF_HOME=../../models
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 数据库 ============
DATABASE_URL=sqlite+aiosqlite:///./kra.db

# ============ 向量库（企业知识库 RAG，docker compose up -d qdrant）============
QDRANT_URL=http://localhost:6333

# ============ 知识库检索（混合检索：bge-m3 dense+sparse 双路 RRF）============
KB_MIN_SCORE=0.45
KB_SPARSE_MIN_WEIGHT=0.5
HYBRID_SEARCH=true

# ============ 查询增强（提问前 LLM 改写+关键词扩展）============
QUERY_PROCESSING=true

# ============ 重排（RRF 融合后 bge-reranker-v2-m3 模型精排）============
RERANK_ENABLED=true

# ============ PDF 智能解析（类型分流 + 版面还原 + 图片 OCR）============
PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS=50
PDF_MARGIN_TOP=0.05
PDF_MARGIN_BOTTOM=0.95

# ============ GROBID 章节结构 ============
# auto=优先 GROBID，失败回退 PyMuPDF；pymupdf=只用旧解析
PARSER_MODE=auto
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=180

# ============ 批量入库 ============
# 0=全部切片；>0 限制每篇切片数（快速覆盖用）
INGEST_MAX_CHUNKS=0
# true=只写 dense，不写 sparse（批量入库加速）
INGEST_DENSE_ONLY=false

# ============ 上传限制 ============
MAX_UPLOAD_MB=100

# ============ VLM 图表多模态理解（OpenAI 兼容，mimo-v2.5；Key 留空自动关闭）============
VLM_API_KEY=
VLM_BASE_URL=https://api.xiaomimimo.com/v1
VLM_MODEL=mimo-v2.5

# ============ 服务 ============
API_HOST=0.0.0.0
API_PORT=8900
CORS_ORIGINS=http://localhost:5173

# ============ 检索开关：多查询检索（改写时生成 sub_queries 多路语义检索）============
MULTI_QUERY=true

# ============ 知网检索：CNKI-Enhanced-MCP ============
# auto=MCP 可用就走，否则降级 site:cnki.net；fallback=始终走降级
CNKI_MODE=auto
# A/B 开关：false 时整个知网源跳过；FORCE=true 时强制加入 Planner 计划（评测用）
CNKI_ENABLED=true
CNKI_FORCE=false
CNKI_MAX_RESULTS=5

# ============ 评估裁判 LLM（仅 eval_run.py 的 ragas 评分用，留空回退 DEEPSEEK_*）============
# 换便宜模型省钱：同家非推理模型、其他低价 API，或本地 Ollama（Key 随意填）
#   Ollama 示例：EVAL_JUDGE_BASE_URL=http://localhost:11434/v1  EVAL_JUDGE_MODEL=qwen2.5:7b
# 注意：更换裁判后 ragas 分数口径会变，需用 --save-baseline 重新锚定基线
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=

# ============ 检索增强二批：HyDE 假设答案变体（每问 +1 次 LLM 调用）============
HYDE_ENABLED=true

# ============ 兄弟切片扩展：命中切片 ±1 邻居自动入候选（零 LLM 成本）============
SIBLING_EXPAND=true
